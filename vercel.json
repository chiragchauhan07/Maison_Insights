{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "maison-app": {
      "root": ".",
      "entrypoint": "server:app",
      "framework": "fastapi",
      "functions": {
        "server.py": { "maxDuration": 300 }
      }
    }
  },
  "daemons": {
    "review-worker": {
      "root": ".",
      "entrypoint": "Dockerfile",
      "instances": { "bom1": 1 },
      "command": ["python", "worker.py"]
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": { "service": "maison-app" }
    },
    {
      "source": "/(.*)",
      "destination": { "service": "maison-app" }
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self'; style-src 'self' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'" }
      ]
    }
  ]
}
